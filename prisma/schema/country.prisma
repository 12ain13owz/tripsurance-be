model Country {
  id        String    @id @default(cuid())
  isoCode   String    @unique // ISO 3166-1 alpha-2, e.g. "JP", "FR"
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  planCountries PlanCountry[] // schema-only back-relation; country code never reads it
}