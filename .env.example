PORT="3000"
NODE_ENV="development"
BASE_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:4000,http://localhost:4200"
LOG_LEVEL_CONSOLE="debug"
LOG_LEVEL_FILE="info"
LOG_LEVEL_ERROR_FILE="error"
SHUTDOWN_TIMEOUT_MS="10000"
DATABASE_URL="postgresql://user_postgres:pass_postgres@localhost:5432/tripsurance"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES="7d"
# COOKIE_DOMAIN="tripsurance.com" # optional; production only, shares refresh cookie across api./app. subdomains